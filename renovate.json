{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "dependencyDashboard": true,
  "prHourlyLimit": 1,
  "prConcurrentLimit": 3,
  "schedule": [
    "before 6am on monday"
  ],
  "ocb": {
    "managerFilePatterns": [
      "/(^|/)builder-config\\.ya?ml$/"
    ]
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)Makefile$/"
      ],
      "matchStrings": [
        "(?:^|\\r\\n|\\r|\\n)OCB_VERSION\\s*\\?=\\s*(?<currentValue>\\S+)"
      ],
      "depNameTemplate": "go.opentelemetry.io/collector/cmd/builder",
      "datasourceTemplate": "go"
    }
  ],
  "packageRules": [
    {
      "matchManagers": [
        "ocb",
        "gomod",
        "custom.regex"
      ],
      "matchDepNames": [
        "/^go\\.opentelemetry\\.io\\/collector\\//"
      ],
      "groupName": "OpenTelemetry Collector modules"
    },
    {
      "matchManagers": [
        "ocb",
        "gomod"
      ],
      "matchDepNames": [
        "/^github\\.com\\/open-telemetry\\/opentelemetry-collector-contrib\\//"
      ],
      "groupName": "OpenTelemetry Collector contrib modules"
    },
    {
      "matchManagers": [
        "gomod"
      ],
      "matchDepNames": [
        "/^github\\.com\\/prometheus-community\\/stackdriver_exporter/"
      ],
      "groupName": "stackdriver exporter modules"
    },
    {
      "matchManagers": [
        "gomod"
      ],
      "matchDepNames": [
        "/^github\\.com\\/prometheus-community\\/yet-another-cloudwatch-exporter/"
      ],
      "groupName": "YACE exporter modules"
    }
  ]
}
